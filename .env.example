LINEAR_WEBHOOK_SECRET=your-linear-webhook-secret-here
LINEAR_API_KEY=lin_api_xxx

# REQUIRED: your Linear team UUID. Used to look up workflow state IDs
# (Backlog / Todo / AI Implementation / In Review / Done). Find via:
#   curl -sS https://api.linear.app/graphql -H "Authorization: $LINEAR_API_KEY" \
#     -H "Content-Type: application/json" \
#     -d '{"query":"{teams{nodes{id name key}}}"}' | jq '.data.teams.nodes[]'
LINEAR_TEAM_ID=00000000-0000-0000-0000-000000000000

# Optional: enable the lightweight proxy flow (Phase 4) for tickets in a
# specific Linear project. Tickets in this project skip the build-with-merge
# stage — Claude answers directly as a Linear comment, status goes straight
# to Done. Typical use case: mobile-first Q&A / one-shot tasks.
#
# To enable:
#   1. Create a Linear project (any name; we use "⚡ Ad-hoc AI Proxy")
#   2. Open the project, copy the project UUID from the URL or Linear API
#   3. Paste it below
# Leave empty / unset to disable proxy flow (Stage 1 build-with-merge runs
# on every trigger).
# LINEAR_PROXY_PROJECT_ID=00000000-0000-0000-0000-000000000000

# Optional: override the git author identity used for executor commits.
# Defaults: executor@example.com / Linear-Executor.
# LINEAR_EXECUTOR_GIT_EMAIL=executor@your-domain.com
# LINEAR_EXECUTOR_GIT_NAME=Linear-Executor

# Optional: per-path subprocess timeouts (seconds). Stage 1 covers real
# coding / multi-step research; Proxy covers mobile-style ad-hoc Q&A. Per-
# ticket override via the ``timeout:<sec>`` Linear label, clamped at 2 h.
# Defaults: Stage 1 = 1200s (20 min), Proxy = 300s (5 min).
# LINEAR_EXECUTOR_TIMEOUT_STAGE1=1200
# LINEAR_EXECUTOR_TIMEOUT_PROXY=300

# Optional: where to create per-ticket folders (Stage 1 worktrees and the
# fallback when no `folder:` override and no PROJECT_FOLDERS mapping match).
# Default: ~/.linear-executor/tickets/
# LINEAR_EXECUTOR_TICKETS_BASE=~/code/tickets/

# Optional: where ad-hoc proxy mode creates its work dirs.
# Default: <package>/proxy-outputs/ (next to the installed code).
# LINEAR_EXECUTOR_PROXY_BASE=~/.linear-executor/proxy-outputs/

# Optional: override default SQLite DB path (default: <package>/state/jobs.db)
# LINEAR_EXECUTOR_DB=/path/to/custom/jobs.db
